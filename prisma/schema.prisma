generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id String @id @default(cuid())

  email             String    @unique @db.VarChar(255)
  emailNormalized   String    @unique @db.VarChar(255)
  name              String?   @db.VarChar(255)
  lastLoginAt       DateTime?
  passwordHash      String    @db.VarChar(255)
  passwordChangedAt DateTime?
  passwordHistory   AdminPasswordHistory[]

  status          AdminStatus @default(PENDING)
  emailVerifiedAt DateTime?

  // 2FA (TOTP secret is AES-256-GCM encrypted, never plaintext)
  totpEnabled         Boolean   @default(false)
  totpSecretEncrypted String?   @db.Text
  totpEnrolledAt      DateTime?

  // 2FA via emailed one-time code (alternative to TOTP; either enables 2FA)
  emailOtpEnabled    Boolean   @default(false)
  emailOtpEnrolledAt DateTime?
  emailOtps          AdminEmailOtp[]

  // Lockout / throttling counters
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Token/session version — bump to revoke all JWTs + sessions
  tokenVersion Int @default(0)

  // Permission cache version — bumped whenever this admin's effective
  // permissions may have changed (role assignment, role perms, role/
  // permission status). Redis keys embed this version so stale sets
  // can never authorize after a change (PDF §13–14).
  permissionsVersion Int @default(0)

  roles    AdminRoleAssignment[]
  sessions AdminSession[]
  recoveryCodes AdminRecoveryCode[]
  resetTokens   AdminPasswordResetToken[]
  loginEvents   AdminLoginActivity[]
  auditEvents   AdminAuditLog[] @relation("AuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("admin_users")
}

model AdminPasswordHistory {
  id        String   @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  passwordHash String @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@map("admin_password_history")
}

model AdminRole {
  id          String  @id @default(cuid())
  key         String  @unique @db.VarChar(64) // e.g. super_admin, sub_admin, support
  name        String  @db.VarChar(128)
  description String? @db.VarChar(500)
  isSystem    Boolean @default(false) // system roles cannot be deleted
  status      RoleStatus @default(ACTIVE) // INACTIVE roles grant nothing

  permissions AdminRolePermission[]
  assignments AdminRoleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("admin_roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique @db.VarChar(128) // canonical module.action, e.g. session.revoke
  module      String  @db.VarChar(64) // e.g. admin, role, audit, session
  action      String  @db.VarChar(64) // e.g. read, create, revoke
  label       String? @db.VarChar(128) // UI display name, safe to rename
  description String? @db.VarChar(500)
  status      PermissionStatus @default(ACTIVE) // INACTIVE can never authorize
  isSystem    Boolean @default(false) // system permissions cannot be deleted

  roles AdminRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module])
  @@index([status])
  @@map("permissions")
}

model AdminRolePermission {
  roleId       String
  permissionId String
  role         AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminRoleAssignment {
  adminId    String
  roleId     String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role       AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy String? // acting admin id (audit join, no FK to allow retention)
  assignedAt DateTime @default(now())

  @@id([adminId, roleId])
  @@index([roleId])
  @@map("admin_role_assignments")
}

// One row per refresh-token family. Refresh token itself is opaque;
// only its SHA-256 hash is stored. Rotation creates a new row chained
// via previousTokenHash; reuse of a rotated token revokes the family.
model AdminSession {
  id String @id @default(cuid())

  adminId String
  admin   AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  refreshTokenHash         String    @unique @db.VarChar(128)
  previousTokenHash        String?   @db.VarChar(128)
  familyId                 String    @db.VarChar(64)
  ipAddress                String?   @db.VarChar(64)
  userAgent                String?   @db.VarChar(512)
  expiresAt                DateTime
  revokedAt                DateTime?
  revokeReason             String?   @db.VarChar(128)
  lastUsedAt               DateTime  @default(now())
  createdAt                DateTime  @default(now())

  @@index([adminId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AdminRecoveryCode {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash   String    @db.VarChar(255) // Argon2id hash, single-use
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([adminId])
  @@map("admin_recovery_codes")
}

model AdminPasswordResetToken {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(128) // SHA-256 of opaque token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_password_reset_tokens")
}

// Short-lived emailed 2FA codes. The 6-digit code is Argon2id-hashed
// (never plaintext), single-outstanding per admin, max 5 attempts, 10-min
// TTL. Purposes: ENABLE (prove mailbox ownership) and LOGIN (2FA challenge).
model AdminEmailOtp {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash  String    @db.VarChar(255)
  purpose   String    @db.VarChar(32)
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId, createdAt])
  @@index([expiresAt])
  @@map("admin_email_otps")
}

model AdminLoginActivity {
  id        String  @id @default(cuid())
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  event     LoginEventType
  outcome   LoginOutcome
  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(512)
  sessionId String? @db.VarChar(64)
  requestId String? @db.VarChar(64)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([event, createdAt])
  @@map("admin_login_activity")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      AdminUser? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  // Write-time snapshots (spec §3.1): history must read correctly after the
  // actor is renamed or the target role/admin is deleted. Resolved by
  // recordAudit inside the writing transaction; never JOINed at read time.
  actorEmail    String? @db.VarChar(320)
  actorName     String? @db.VarChar(128)
  resourceLabel String? @db.VarChar(320)
  action     String   @db.VarChar(128) // e.g. admin.suspend, role.assign
  resourceType String @db.VarChar(64)
  resourceId   String? @db.VarChar(64)
  before       Json?
  after        Json?
  ipAddress    String? @db.VarChar(64)
  userAgent    String? // unbounded: UA strings vary wildly in length
  requestId    String? @db.VarChar(64)
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("admin_audit_log")
}

enum AdminStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum PermissionStatus {
  ACTIVE
  INACTIVE
}

enum LoginEventType {
  LOGIN_ATTEMPT
  LOGIN_SUCCESS
  LOGIN_FAILURE
  TWO_FA_CHALLENGE
  TWO_FA_SUCCESS
  TWO_FA_FAILURE
  RECOVERY_CODE_USED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  TWO_FA_ENROLLED
  TWO_FA_DISABLED
  SESSION_CREATED
  SESSION_REVOKED
  SESSION_EXPIRED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  LOGIN_BLOCKED_STATUS
}

enum LoginOutcome {
  SUCCESS
  FAILURE
}

// ─── Global attributes (platform-level lookup catalog) ──────────────────────
// One table backs every panel-agnostic dropdown/lookup: categories,
// payment types, countries, languages, currencies, … Rows are namespaced by
// `type`; frontends render one screen per type but consume the same CRUD
// APIs. Never scoped to a store — platform admins own this catalog.
model Attribute {
  id String @id @default(cuid())

  type  String @db.VarChar(64) // e.g. category, payment_type, country, language
  key   String @db.VarChar(128) // slug, unique per type, e.g. "fashion", "upi"
  label String @db.VarChar(255) // display name
  value String? @db.VarChar(255) // optional code/payload, e.g. "INR", "+91"

  description String? @db.VarChar(500)
  metadata    Json?
  sortOrder   Int     @default(0)

  status   AttributeStatus @default(ACTIVE)
  isSystem Boolean         @default(false) // system rows cannot be deleted

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, key])
  @@index([type, status, sortOrder])
  @@map("attributes")
}

enum AttributeStatus {
  ACTIVE
  INACTIVE
}

// ─── Seller panel (tenant/store-scoped domain) ──────────────────────────────
// Identity is intentionally separate from AdminUser: platform admins govern
// the marketplace, seller users own/belong to stores. One user ⇄ N stores
// via StoreMembership (UNIQUE(storeId,userId)). Every seller-side resource
// must ultimately belong to a Store; authorization always resolves
// user → membership(store) → role → permissions, never trusting client
// store context alone.

model SellerUser {
  id String @id @default(cuid())

  email           String    @unique @db.VarChar(255)
  emailNormalized String    @unique @db.VarChar(255)
  name            String?   @db.VarChar(255)
  passwordHash    String    @db.VarChar(255)
  lastLoginAt     DateTime?

  status          SellerStatus @default(ACTIVE)
  emailVerifiedAt DateTime?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Bump to revoke all JWTs + sessions (global logout / compromise).
  tokenVersion Int @default(0)

  sessions     SellerSession[]
  memberships  StoreMembership[]
  ownedStores  Store[]           @relation("StoreOwner")
  sentInvites  StoreInvitation[] @relation("InvitationInviter")
  auditEvents  StoreAuditLog[]   @relation("StoreAuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("seller_users")
}

model SellerSession {
  id String @id @default(cuid())

  sellerId String
  seller   SellerUser @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  refreshTokenHash  String    @unique @db.VarChar(128)
  previousTokenHash String?   @db.VarChar(128)
  familyId          String    @db.VarChar(64)
  ipAddress         String?   @db.VarChar(64)
  userAgent         String?   @db.VarChar(512)
  expiresAt         DateTime
  revokedAt         DateTime?
  revokeReason      String?   @db.VarChar(128)
  lastUsedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())

  @@index([sellerId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("seller_sessions")
}

model Store {
  id String @id @default(cuid())

  name        String  @db.VarChar(128)
  slug        String  @unique @db.VarChar(128)
  logo        String? @db.VarChar(512)
  description String? @db.VarChar(1000)
  category    String? @db.VarChar(128)

  status StoreStatus @default(PENDING_SETUP)

  ownerId String
  owner   SellerUser @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  country   String? @db.VarChar(64)
  currency  String  @default("INR") @db.VarChar(8)
  timezone  String  @default("Asia/Kolkata") @db.VarChar(64)
  contactEmail String? @db.VarChar(255)
  contactPhone String? @db.VarChar(32)

  onboardingCompletedAt DateTime?

  deletedAt DateTime?

  memberships   StoreMembership[]
  roles         StoreRole[]
  invitations   StoreInvitation[]
  auditLogs     StoreAuditLog[]
  subscriptions StoreSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@map("stores")
}

model StoreMembership {
  id String @id @default(cuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String
  user   SellerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId String
  role   StoreRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())

  invitedBy String? @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, userId])
  @@index([userId])
  @@index([storeId, status])
  @@map("store_memberships")
}

model StoreRole {
  id String @id @default(cuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  key         String  @db.VarChar(64)
  name        String  @db.VarChar(128)
  description String? @db.VarChar(500)
  isSystem    Boolean @default(false)
  status      RoleStatus @default(ACTIVE)

  permissions StoreRolePermission[]
  memberships StoreMembership[]
  invitations StoreInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, key])
  @@index([storeId, status])
  @@map("store_roles")
}

model StorePermission {
  id String @id @default(cuid())

  // Store domain uses resource:action (e.g. product:create) — deliberately
  // distinct from the platform domain's module.action so the two RBAC
  // systems can never be confused.
  key         String  @unique @db.VarChar(128)
  resource    String  @db.VarChar(64)
  action      String  @db.VarChar(64)
  label       String? @db.VarChar(128)
  description String? @db.VarChar(500)
  isSystem    Boolean @default(true)

  roles StoreRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resource])
  @@map("store_permissions")
}

model StoreRolePermission {
  roleId       String
  role         StoreRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   StorePermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@map("store_role_permissions")
}

model StoreInvitation {
  id String @id @default(cuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  email           String @db.VarChar(255)
  emailNormalized String @db.VarChar(255)

  roleId String
  role   StoreRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  tokenHash String    @unique @db.VarChar(128)
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime

  invitedById String?
  invitedBy   SellerUser? @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([storeId, status])
  @@index([emailNormalized])
  @@index([expiresAt])
  @@map("store_invitations")
}

model StoreAuditLog {
  id String @id @default(cuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  actorId String?
  actor   SellerUser? @relation("StoreAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String? @db.VarChar(320)

  action       String  @db.VarChar(128)
  resourceType String  @db.VarChar(64)
  resourceId   String? @db.VarChar(64)
  metadata     Json?
  ipAddress    String? @db.VarChar(64)
  userAgent    String?
  requestId    String? @db.VarChar(64)
  createdAt    DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("store_audit_log")
}

model SubscriptionPlan {
  id String @id @default(cuid())

  key         String  @unique @db.VarChar(64)
  name        String  @db.VarChar(128)
  description String? @db.VarChar(500)

  pricePaise   Int @default(0)
  currency     String @default("INR") @db.VarChar(8)
  billingCycle BillingCycle @default(MONTHLY)

  // Entitlement limits, e.g. { "products.max": 100, "staff.max": 5 }.
  // Enforced by an entitlement service — never hardcoded plan branches.
  limits Json?

  trialDays Int @default(0)
  isActive  Boolean @default(true)

  subscriptions StoreSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_plans")
}

model StoreSubscription {
  id String @id @default(cuid())

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  status SubscriptionStatus @default(TRIALING)
  billingCycle BillingCycle @default(MONTHLY)

  provider                 String?   @db.VarChar(64)
  providerCustomerId       String?   @db.VarChar(128)
  providerSubscriptionId   String?   @db.VarChar(128)
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  trialStart               DateTime?
  trialEnd                 DateTime?
  cancelAt                 DateTime?
  cancelledAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, status])
  @@index([status, currentPeriodEnd])
  @@map("store_subscriptions")
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum StoreStatus {
  PENDING_SETUP
  ACTIVE
  SUSPENDED
  PAYMENT_REQUIRED
  PAUSED
  CLOSED
  DELETED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}
