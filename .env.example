# Copy to .env and fill in real secrets (never commit .env)
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Postgres via Docker (local dev + integration tests; host port 5433 — 5432 is blocked on Windows)
DATABASE_URL="postgresql://ecomm:ecomm_dev_password@127.0.0.1:5433/ecomm"
POSTGRES_PASSWORD=ecomm_dev_password

# Production (Neon, SSL REQUIRED) — copy these keys into .env.production
# or your host's env dashboard. Never commit real passwords.
# DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require"
# Optional CA pinning (PEM contents): DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----..."
# Upstash REST (health checks): UPSTASH_REDIS_REST_URL="https://...upstash.io"
# UPSTASH_REDIS_REST_TOKEN="<token>"
# Native Redis (sessions/cache via ioredis): REDIS_URL="rediss://...upstash.io:6379"

# Isolated integration-test database (never production data)
TEST_DATABASE_URL="postgresql://ecomm:ecomm_dev_password@127.0.0.1:5433/ecomm_test"

# Redis via Docker
REDIS_URL="redis://127.0.0.1:6379"

# Auth / crypto — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TOTP_ENCRYPTION_KEY must be 64 hex chars (32 bytes) outside local dev.
JWT_ACCESS_SECRET=change-me-32-bytes-min
JWT_ACCESS_TTL_SECONDS=300
REFRESH_TOKEN_PEPPER=change-me
TOTP_ENCRYPTION_KEY=change-me-32-byte-hex

# Super Admin bootstrap (used ONLY by `npx prisma db seed`)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Outgoing mail (password reset). Without these, mail is LOGGED ONLY — nothing is sent.
# Gmail needs an App Password (Google Account → Security → 2-Step Verification →
# App passwords → generate 16-char code). Your normal login password will NOT work.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# MAIL_FROM=E-Comm Admin <you@gmail.com>
# Behind a TLS-intercepting proxy/AV ("self-signed certificate in chain"
# errors)? Set SMTP_TLS_INSECURE=true on a trusted local network only.
# Never enable it in production.
# SMTP_TLS_INSECURE=false

# Cookie / CORS — no trailing slash; comma-separated allowlist allowed, e.g.
# FRONTEND_ORIGIN=https://aurora-frontend-nna1.vercel.app,http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# Rate limiting (global + login-specific per 15 min per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=20

# Render keep-alive self-ping (prevents free-tier spin-down).
# Render injects RENDER_EXTERNAL_URL automatically — nothing to set there.
# Enabled by default in production, off elsewhere. Interval is in ms (4590 ≈ 4.59s).
# KEEP_ALIVE_ENABLED=true
# KEEP_ALIVE_INTERVAL_MS=4590
# KEEP_ALIVE_URL=https://your-service.onrender.com

LOG_LEVEL=info
