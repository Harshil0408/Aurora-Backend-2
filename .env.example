# Copy to .env and fill in real secrets (never commit .env)
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# MySQL (must match docker-compose.yml)
DATABASE_URL="mysql://ecomm:ecomm_dev_password@127.0.0.1:3306/ecomm"

# Redis
REDIS_URL="redis://127.0.0.1:6379"

# Auth / crypto (Phase 2 will use these — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=change-me-32-bytes-min
REFRESH_TOKEN_PEPPER=change-me
TOTP_ENCRYPTION_KEY=change-me-32-byte-hex

# Cookie / CORS
COOKIE_DOMAIN=
FRONTEND_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

LOG_LEVEL=info
